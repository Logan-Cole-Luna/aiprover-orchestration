{
 "agents": {
  "captain": {
   "timeout": 2400,
   "max_output_tokens": 128000,
   "backend": "claude",
   "model": "claude-opus-5-5",
   "effort": "high",
   "phases": {
    "judge": {
     "model": "claude-sonnet-5-5",
     "effort": "medium"
    },
    "formalize": {
     "effort": "medium"
    },
    "handback": {
     "max_output_tokens": 32000
    }
   }
  },
  "auditor": {
   "backend": "claude",
   "model": "claude-sonnet-5-5"
  },
  "reviewer": {
   "timeout": 2400,
   "max_output_tokens": 128000,
   "backend": "claude",
   "model": "claude-opus-5-5",
   "effort": "high"
  },
  "writer": {
   "timeout": 2400,
   "max_output_tokens": 128000,
   "backend": "claude",
   "model": "claude-opus-5-5",
   "effort": "high"
  },
  "solver": {
   "backend": "aiprover",
   "model": "aiprover",
   "config": "configs/aiprover/vista_logged_openai.toml",
   "cli": "AIProver/AIProver_plugin/bin/aiprover",
   "timeout": 5400,
   "max_turns": 200
  }
 },
 "workers": 2,
 "max_repairs": 4,
 "max_replans": 2,
 "max_audit_rounds": 2,
 "lean_parallel": 4,
 "lean_timeout": 300,
 "max_claude_calls": 30,
 "aiprover_lemma_concurrency": 0,
 "aiprover_attempts_per_lemma": 5,
 "aiprover_session_slots": 8,
 "aiprover_handback_after": 3,
 "max_handbacks": 12,
 "final_claude_calls": 8,
 "informal_claude_calls": 6,
 "library": "",
 "extend_library": false
}

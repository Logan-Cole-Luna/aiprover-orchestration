#!/bin/sh
# ./setup: from a fresh clone to a working aiprover-captain skill, on Linux, WSL2 or macOS.
#
#   ./setup --endpoint URL                      a model server reachable from this device
#   ./setup --endpoint URL --via HOST           a server reachable only from HOST: SSH tunnel
#   ./setup --via HOST --handoff FILE           a server job that writes its node and port to FILE
#                                               on HOST (`node=<n> port=<p>`), followed on restart
#   ./setup --endpoint none                     no model server: Claude subagents prove the lemmas
#   ./setup                                     keep the existing endpoint, or ask for one
#
#   --via HOST           an SSH host or an alias of ~/.ssh/config
#   --user USER          SSH user, when ~/.ssh/config does not set one for HOST
#   --api-key KEY        bearer token of the model server (direct connection)
#   --timeout SEC        wall clock of one AIProver session (default 5400)
#   --max-turns N        turn budget of one AIProver session (default 200)
#   Shortcuts for this project's servers: --endpoint dgx, --endpoint vista.
#   --lean-project PATH  use an existing Lean project (default: aiprover/lean_project)
#   --harness PATH       use the AIProver harness checkout at PATH instead of the AIProver/
#                        submodule (linked as aiprover/harness; the central AIProver repository
#                        passes its harness/); kept on later runs until --harness is given again
#   --no-plugin          link the config but install no Claude Code plugin (another
#                        marketplace, such as the central repository's skill/, installs it)
#   --yes                accept every default (the Nix installer still shows what it runs)
#   --dry-run            print what would happen; change nothing
#   --no-lean            skip the Lean build and the plugin installation (to change the endpoint)
#   --installer official|determinate
#
# Steps: check the platform; fetch the submodules; find Nix, or offer to install it; build the
# tools and the AIProver virtualenvs into aiprover/nix/; write orchestration_plugin/aiprover.toml;
# then orchestration_plugin/setup.sh lean claude endpoint doctor (link in place of claude with
# --no-plugin). Every Nix command passes `--extra-experimental-features 'nix-command flakes'`,
# so flakes need not be enabled.
#
# POSIX sh on purpose: it runs before anything else is installed.
set -eu

NIX_FEATURES="nix-command flakes"
MIN_FREE_GB=15
DGX_URL="http://cic-dgx-01.tacc.cloud:8040"
ORCHESTRATION_VM="129.114.35.157"
# Local ports: the SSH tunnel's end and the reasoning proxy the harness talks to.
TUNNEL_PORT=18555
PROXY_PORT=18575
VISTA_HANDOFF="/scratch/11757/loganluna/servers/aiprover_server.txt"

YES=no
DRY=no
LEAN=yes
INSTALLER=official
ENDPOINT=""
VIA=""
SSH_USER=""
API_KEY="EMPTY"
HANDOFF=""
TIMEOUT=""
TURNS=""
LEAN_PROJECT=""
HARNESS=""
PLUGIN=yes

say() { printf '%s\n' "$*"; }
step() { printf '\n==> %s\n' "$*"; }
warn() { printf 'setup: warning: %s\n' "$*" >&2; }
die() {
  printf 'setup: %s\n' "$*" >&2
  exit 1
}

usage() { sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; }

# ask QUESTION DEFAULT(y|n): yes or no from the terminal; --yes answers y.
ask() {
  [ "$YES" = yes ] && return 0
  if [ "$2" = y ]; then hint="[Y/n]"; else hint="[y/N]"; fi
  printf '%s %s ' "$1" "$hint"
  read -r answer || answer=""
  case "$answer" in
  [Yy]*) return 0 ;;
  [Nn]*) return 1 ;;
  *) [ "$2" = y ] ;;
  esac
}

run() {
  if [ "$DRY" = yes ]; then say "would run: $*"; else "$@"; fi
}

nix_cmd() { run nix --extra-experimental-features "$NIX_FEATURES" "$@"; }

# Platform ---------------------------------------------------------------------------------------

check_platform() {
  os=$(uname -s)
  arch=$(uname -m)
  case "$os" in
  Linux)
    if grep -qi microsoft /proc/version 2>/dev/null; then platform="WSL2"; else platform="Linux"; fi
    ;;
  Darwin) platform="macOS" ;;
  *) die "unsupported system $os: use Linux, macOS, or Windows through WSL2" ;;
  esac
  case "$arch" in
  x86_64 | amd64 | aarch64 | arm64) ;;
  *) die "unsupported architecture $arch" ;;
  esac
  step "Platform: $platform ($arch)"
  free_kb=$(df -Pk . | awk 'NR == 2 { print $4 }')
  [ "$((free_kb / 1048576))" -ge "$MIN_FREE_GB" ] \
    || warn "less than $MIN_FREE_GB GB free here: Mathlib and the Nix store need about that"
}

fetch_submodules() {
  if [ -n "$HARNESS" ]; then
    [ -x "$HARNESS/AIProver_plugin/bin/aiprover" ] || die "no AIProver harness at $HARNESS"
    step "Harness: $HARNESS (linked as aiprover/harness; the AIProver/ submodule is not used)"
    run mkdir -p aiprover
    run ln -sfn "$HARNESS" aiprover/harness
    return
  fi
  if [ -e aiprover/harness ]; then
    step "Harness: keeping aiprover/harness -> $(readlink aiprover/harness) (pass --harness to replace it)"
    return
  fi
  step "Submodules: AIProver/"
  run git submodule update --init --recursive
}

# Nix --------------------------------------------------------------------------------------------

load_nix() {
  for profile in /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
    "$HOME/.nix-profile/etc/profile.d/nix.sh"; do
    # shellcheck disable=SC1090  # the installer's own profile script
    [ -f "$profile" ] && . "$profile"
  done
  command -v nix >/dev/null 2>&1
}

install_nix() {
  case "$INSTALLER" in
  official) command="curl -L https://nixos.org/nix/install | sh -s -- --daemon" ;;
  determinate) command="curl -fsSL https://install.determinate.systems/nix | sh -s -- install --prefer-upstream-nix" ;;
  *) die "unknown installer $INSTALLER (official|determinate)" ;;
  esac
  step "Nix: not found"
  say "The $INSTALLER installer would run:"
  say "  $command"
  say "It needs sudo once, to create /nix."
  ask "Install Nix now?" n || die "install Nix, then run ./setup again"
  if [ "$DRY" = yes ]; then say "would run: $command"; return; fi
  sh -c "$command"
  load_nix || die "Nix installed but not found: open a new terminal and run ./setup again"
}

check_nix() {
  if load_nix; then step "Nix: $(nix --version)"; else install_nix; fi
}

# Build the tools and the virtualenvs as GC roots inside the repository, so the skill finds them
# without a Nix shell.
build_environment() {
  step "Environment: tools and AIProver virtualenvs (the first build downloads a few GB)"
  run mkdir -p aiprover/nix
  for package in tools venv-vibe venv-mcp; do
    nix_cmd build ".#$package" --out-link "aiprover/nix/$(printf '%s' "$package" | tr - _)"
  done
}

# Endpoint ---------------------------------------------------------------------------------------

choose_endpoint() {
  if [ -z "$ENDPOINT$HANDOFF" ] && [ -f orchestration_plugin/endpoint.toml ]; then
    step "Endpoint: keeping orchestration_plugin/endpoint.toml (pass --endpoint to replace it)"
    return 1
  fi
  if [ -z "$ENDPOINT$HANDOFF" ]; then
    [ "$YES" = yes ] && die "no endpoint configured: pass --endpoint URL or none (see ./setup --help)"
    printf 'Model server URL (http://host:port; empty for none, Claude proves the lemmas): '
    read -r ENDPOINT || ENDPOINT=""
    ENDPOINT=${ENDPOINT:-none}
  fi
  return 0
}

reachable() { curl -s -m 8 -o /dev/null -f "$1/v1/models"; }

# write_config: orchestration_plugin/aiprover.toml for this device, read by the AIProver CLI.
write_config() {
  mode=direct
  api_base=""
  ssh_host=""
  remote_host=""
  remote_port=8060
  handoff=""
  socket=""
  timeout=5400
  turns=200
  # This project's servers, as shortcuts for the generic options.
  case "$ENDPOINT" in
  dgx)
    ENDPOINT="$DGX_URL"
    reachable "$ENDPOINT" || VIA="${VIA:-$ORCHESTRATION_VM}"
    timeout=10800
    turns=100
    ;;
  vista)
    ENDPOINT=""
    VIA="${VIA:-vista.tacc.utexas.edu}"
    HANDOFF="${HANDOFF:-$VISTA_HANDOFF}"
    ;;
  esac
  timeout="${TIMEOUT:-$timeout}"
  turns="${TURNS:-$turns}"
  case "$ENDPOINT" in
  "" | none | http://* | https://*) ;;
  *) die "unknown endpoint $ENDPOINT: give the model server's URL (http://host:port) or none" ;;
  esac
  if [ "$ENDPOINT" = none ]; then
    # No model server: the harness configuration keeps the Lean paths only, and the skill's
    # solvers are Claude subagents.
    mode=none
    api_base="http://127.0.0.1:$PROXY_PORT/v1"
  elif [ -n "$ENDPOINT" ] && [ -z "$HANDOFF" ] && reachable "${ENDPOINT%/}"; then
    api_base="${ENDPOINT%/}"
  else
    if [ -z "$VIA" ] && [ "$YES" = no ]; then
      printf '%s is not reachable from here. SSH host that reaches it: ' "${ENDPOINT:-the server}"
      read -r VIA || VIA=""
    fi
    [ -n "$VIA" ] || die "${ENDPOINT:-the server} is not reachable from here: pass --via HOST (an SSH host that reaches it)"
    mode=ssh
    ssh_host="$VIA"
    handoff="$HANDOFF"
    socket="~/.ssh/aiprover-$(printf '%s' "$VIA" | tr -c 'A-Za-z0-9.-' '_').sock"
    if [ -n "$ENDPOINT" ]; then
      # The server's host and port as seen from HOST (a fallback when a handoff file is given).
      address=${ENDPOINT#*://}
      address=${address%%/*}
      remote_host=${address%:*}
      case "$address" in
      *:*) remote_port=${address##*:} ;;
      *) case "$ENDPOINT" in https://*) remote_port=443 ;; *) remote_port=80 ;; esac ;;
      esac
    fi
  fi
  [ "$mode" = ssh ] || [ -n "$api_base" ] || die "no api_base for $ENDPOINT"
  [ "$mode" != ssh ] || api_base="http://127.0.0.1:$TUNNEL_PORT/v1"
  case "$api_base" in */v1) ;; *) api_base="$api_base/v1" ;; esac

  if [ "$(uname -s)" = Darwin ]; then
    memory_gb=$(($(sysctl -n hw.memsize) / 1073741824))
  else
    memory_gb=$(($(awk '/^MemTotal:/ { print $2 }' /proc/meminfo) / 1048576))
  fi
  parallel=$((memory_gb / 5))
  [ "$parallel" -ge 1 ] || parallel=1
  [ "$parallel" -le 8 ] || parallel=8

  root=$(pwd)
  if [ "$mode" = ssh ]; then
    target="${ENDPOINT:-server named in $handoff} via $ssh_host"
  elif [ "$mode" = none ]; then
    target="no model server; Claude subagents prove the lemmas"
  else
    target="$api_base"
  fi
  step "Endpoint: $mode, $target"
  if [ "$mode" = ssh ]; then
    upstream="http://127.0.0.1:$TUNNEL_PORT"
  else
    upstream="${api_base%/v1}"
  fi
  # The connection to the model server, opened by orchestration_plugin/setup.sh endpoint.
  endpoint_config=$(
    cat <<EOF
# Connection of the aiprover-captain skill to the model server, written by ./setup for this
# device ($mode, $target). Same [endpoint] format as AIProver/AIProver_plugin/aiprover.toml.
# Edit it freely; ./setup keeps it unless --endpoint is given. After an edit:
#   orchestration_plugin/setup.sh endpoint doctor

[endpoint]
mode = "$mode"
# none: no model server (the skill's solvers are Claude subagents).
# ssh mode: the host you SSH into, and the model's address as seen from it. With server_handoff
# set, the node and port are read from that file on ssh_host (a server job writes it).
ssh_host = "$ssh_host"
ssh_user = "$SSH_USER"
ssh_port = 22
remote_host = "$remote_host"
remote_port = $remote_port
server_handoff = "$handoff"
# The SSH master the tunnel rides; setup.sh connect opens it (it asks for what the host
# requires, such as a password and a one-time code).
control_socket = "$socket"
ssh_options = []
local_port = $TUNNEL_PORT
# direct mode: the server itself.
api_base = "$api_base"
api_key = "$API_KEY"
model = ""

# The reasoning proxy (aiprover_orchestration/server/reasoning_proxy.py) the harness talks to.
# It turns tool calls a server returns as text into structured calls, caps reply length,
# repairs histories the server would reject, and records each session's reasoning.
[proxy]
listen = $PROXY_PORT
upstream = "$upstream"
max_reply_tokens = 16384

[runtime]
work_root = "$root/aiprover/work"
EOF
  )
  # The harness's configuration: the model through the local proxy.
  harness_config=$(
    cat <<EOF
# AIProver configuration of the aiprover-captain skill, written by ./setup for this device.
# The harness reaches the model through the local reasoning proxy, which forwards to the
# server of endpoint.toml ($mode, $target). Same format as AIProver/AIProver_plugin/aiprover.toml.

[endpoint]
mode = "direct"
api_base = "http://127.0.0.1:$PROXY_PORT/v1"
# Sent as a bearer token; the proxy forwards it to the server.
api_key = "$API_KEY"
# Served model id; empty = the first id /v1/models reports.
model = ""

[runtime]
work_root = "$root/aiprover/work"
# Concurrent AIProver sessions on this device (about 5 GB of memory each).
max_parallel = $parallel
timeout_sec = $timeout
max_turns = $turns

[paths]
lean_project = "${LEAN_PROJECT:-$root/aiprover/lean_project}"
elan_home = "~/.elan"
vibe_venv = "$root/aiprover/nix/venv_vibe"
mcp_venv = "$root/aiprover/nix/venv_mcp"
rg_dir = "$root/aiprover/nix/tools/bin"
EOF
  )
  if [ "$DRY" = yes ]; then
    say "would write orchestration_plugin/endpoint.toml:"
    printf '%s\n' "$endpoint_config"
    say "would write orchestration_plugin/aiprover.toml:"
    printf '%s\n' "$harness_config"
  else
    printf '%s\n' "$endpoint_config" > orchestration_plugin/endpoint.toml
    printf '%s\n' "$harness_config" > orchestration_plugin/aiprover.toml
  fi
}

# Lean, plugin, doctor ---------------------------------------------------------------------------

finish() {
  PATH="$(pwd)/aiprover/nix/tools/bin:$PATH"
  export PATH
  if [ "$LEAN" = no ]; then
    step "Connection and doctor (Lean and plugin skipped)"
    run bash orchestration_plugin/setup.sh endpoint doctor
    return
  fi
  if [ "$PLUGIN" = yes ]; then plugin="claude"; else plugin="link"; fi
  step "Lean, Claude Code plugin, endpoint, doctor (the first Lean setup downloads Mathlib's cache, ~5 GB)"
  run bash orchestration_plugin/setup.sh lean "$plugin" endpoint doctor
}

next_steps() {
  step "Done"
  say "1. Restart the Claude Code app (or VS Code); /plugin lists aiprover-orchestration."
  say "2. Open this directory and ask, for example:"
  say "     Use the aiprover-captain skill to formalize and prove <uuid of data/*.jsonl>"
  say "   or paste <informal_theorem>...</informal_theorem> and <informal_proof>...</informal_proof>."
  [ -n "$(ls data/*.jsonl 2>/dev/null)" ] \
    || say "   data/ is not in git: copy data/*.jsonl here to run problems by uuid."
  say "Interactive shell with the same tools: nix develop (or direnv allow)."
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
    --endpoint) ENDPOINT="${2:?--endpoint needs a value}"; shift ;;
    --endpoint=*) ENDPOINT="${1#*=}" ;;
    --via) VIA="${2:?--via needs a host}"; shift ;;
    --user) SSH_USER="${2:?--user needs a name}"; shift ;;
    --api-key) API_KEY="${2:?--api-key needs a value}"; shift ;;
    --handoff) HANDOFF="${2:?--handoff needs a path}"; shift ;;
    --timeout) TIMEOUT="${2:?--timeout needs seconds}"; shift ;;
    --max-turns) TURNS="${2:?--max-turns needs a number}"; shift ;;
    --lean-project) LEAN_PROJECT="${2:?--lean-project needs a path}"; shift ;;
    --harness) HARNESS=$(cd "${2:?--harness needs a path}" && pwd -P) || die "no directory $2"; shift ;;
    --no-plugin) PLUGIN=no ;;
    --installer) INSTALLER="${2:?--installer needs a name}"; shift ;;
    --yes | -y) YES=yes ;;
    --dry-run) DRY=yes ;;
    --no-lean) LEAN=no ;;
    -h | --help) usage; exit 0 ;;
    *) die "unknown option $1 (see ./setup --help)" ;;
    esac
    shift
  done
  cd "$(dirname "$0")"
  [ -f flake.nix ] && [ -d orchestration_plugin ] || die "run ./setup from the repository root"
  check_platform
  fetch_submodules
  check_nix
  build_environment
  if choose_endpoint; then write_config; fi
  finish
  next_steps
}

main "$@"

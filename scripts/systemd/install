#!/bin/sh
# Install systemd user units of this directory for this checkout and account, then enable and
# start them. The units are written for the orchestration VM; this rewrites their paths:
# the checkout, the home directory, and the interpreter, which is the one ./setup builds
# (aiprover/nix/venv_search for the search services, aiprover/nix/tools otherwise) unless
# AIPROVER_PYTHON names another.
#
#   scripts/systemd/install aiprover_query_server aiprover_paper_search ...
set -eu

root=$(cd "$(dirname "$0")/../.." && pwd)
units="$HOME/.config/systemd/user"
mkdir -p "$units"
for unit in "$@"; do
  source="$root/scripts/systemd/$unit.service"
  [ -f "$source" ] || { echo "no unit $source" >&2; exit 1; }
  case $unit in
    *mathlib_index|*paper_search) python=$root/aiprover/nix/venv_search/bin/python3 ;;
    *) python=$root/aiprover/nix/tools/bin/python3 ;;
  esac
  python=${AIPROVER_PYTHON:-$python}
  sed -e "s|/home/loganluna/workspace/aiprover_orchestration|$root|g" \
      -e "s|/home/loganluna/lean_env/bin/python3|$python|g" \
      -e "s|/home/loganluna/lean_env/bin|$(dirname "$python")|g" \
      -e "s|/home/loganluna|$HOME|g" \
      "$source" > "$units/$unit.service"
  echo "installed $units/$unit.service ($python)"
done
systemctl --user daemon-reload
systemctl --user enable --now "$@"

# Semantic search over arXiv math abstracts, and the text of papers, for the
# `paper-search` command (aiprover_orchestration/search/papers.py). Build or
# download the index first; install with scripts/systemd/install.
[Unit]
Description=AIProver arXiv paper search
After=network-online.target

[Service]
WorkingDirectory=@ROOT@
# pdftotext converts papers without an HTML version.
Environment=PATH=@ROOT@/aiprover/nix/tools/bin:@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@PYTHON@ -m aiprover_orchestration.search.papers --index data/arxiv_index --port 18571 --threads 4
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

# Semantic search over the pinned Mathlib with the Lean Finder protocol
# (aiprover_orchestration/search/server.py); harness configs point
# `leanfinder_url` at it. Install with scripts/systemd/install.
[Unit]
Description=AIProver semantic Mathlib index
After=network-online.target

[Service]
WorkingDirectory=@ROOT@
ExecStart=@PYTHON@ -m aiprover_orchestration.search.server --index data/mathlib_index --port 18570 --threads 4
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

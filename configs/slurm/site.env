# Site values of a Slurm cluster, sourced by scripts/slurm/env.sh; fill in the empty values.
# An untracked configs/site.env, if it exists, is sourced instead of this file.
# Account that sbatch charges.
export SBATCH_ACCOUNT=
# Directory of the model weights that the server job serves with vLLM.
export AIPROVER_MODEL=
# GPUs of the server job, as sbatch writes them, for example a100:4.
export AIPROVER_GPUS=
# Optional: the Lean project (default $SCRATCH/aiprover_lean_project), the vLLM virtual
# environment (default beside it), and further sbatch options of the server job.
# export AIPROVER_LEAN_PROJECT=
# export VLLM_VENV=
# export AIPROVER_SERVER_ARGS=

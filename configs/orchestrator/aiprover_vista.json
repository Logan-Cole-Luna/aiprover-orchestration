{
  "agents": {
    "captain": {
      "backend": "claude",
      "model": "claude-opus-5-5",
      "timeout": 2400
    },
    "auditor": {
      "backend": "claude",
      "model": "claude-haiku-4-5-20251001"
    },
    "solver": {
      "backend": "aiprover",
      "model": "aiprover",
      "config": "configs/aiprover/vista.toml",
      "cli": "AIProver/AIProver_plugin/bin/aiprover",
      "timeout": 5400,
      "max_turns": 100
    }
  },
  "workers": 4,
  "max_repairs": 4,
  "max_replans": 2,
  "max_audit_rounds": 2,
  "lean_parallel": 6,
  "lean_timeout": 300
}

{
  "agents": {
    "orchestrator": {
      "backend": "claude",
      "model": "claude-sonnet-5-5",
      "timeout": 2400
    },
    "checker": {
      "backend": "claude",
      "model": "claude-sonnet-5-5"
    },
    "prover": {
      "backend": "aiprover",
      "model": "aiprover",
      "config": "configs/aiprover/vista.toml",
      "timeout": 1800,
      "max_turns": 60
    }
  },
  "workers": 2,
  "max_repairs": 4,
  "max_replans": 1,
  "max_audit_rounds": 2,
  "lean_parallel": 4,
  "lean_timeout": 300
}

{
  "agents": {
    "orchestrator": {
      "timeout": 2400,
      "max_output_tokens": 128000,
      "backend": "openai_compatible",
      "model": "aiprover",
      "base_url": "http://127.0.0.1:18575/v1",
      "tools": true
    },
    "checker": {
      "backend": "openai_compatible",
      "model": "aiprover",
      "base_url": "http://127.0.0.1:18575/v1"
    },
    "reviewer": {
      "timeout": 2400,
      "max_output_tokens": 128000,
      "backend": "openai_compatible",
      "model": "aiprover",
      "base_url": "http://127.0.0.1:18575/v1"
    },
    "writer": {
      "timeout": 2400,
      "max_output_tokens": 128000,
      "backend": "openai_compatible",
      "model": "aiprover",
      "base_url": "http://127.0.0.1:18575/v1"
    },
    "prover": {
      "backend": "aiprover",
      "model": "aiprover",
      "config": "orchestration_plugin/aiprover.toml",
      "timeout": 3600,
      "max_turns": 200
    }
  },
  "workers": 2,
  "max_repairs": 4,
  "max_replans": 2,
  "max_audit_rounds": 2,
  "lean_parallel": 4,
  "lean_timeout": 300,
  "max_hosted_calls": 100,
  "aiprover_attempts_per_lemma": 5,
  "aiprover_session_slots": 8,
  "aiprover_job_sessions": 3,
  "aiprover_escalation_after": 2,
  "max_escalations": 12,
  "final_hosted_calls": 8
}